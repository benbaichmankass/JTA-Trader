# ============================================
# ICT WORK DIGEST SYSTEMD TIMER (MI-83)
# Triggers ict-work-digest.service every 5 minutes (ALERT-LEDGER-TO-MANAGER); the HOURLY digest
# inside it is unchanged: work_digest_now.py keeps its hour latch + _cadence_gate.
# Save to: /etc/systemd/system/ict-work-digest.timer
# ============================================

[Unit]
Description=Trigger ict-work-digest every 5 minutes (alert_watch pass; hourly digest self-gated)

[Timer]
# Hourly, matching the operator's stated cadence (2026-09-02, verbatim: "I
# realize that's a lot of noise, but that's how I want it for now until we get
# a little more settled in").
# ALERT-LEDGER-TO-MANAGER: the alert_watch pass needs a VM clock fast enough to reach the manager inside
# 10 min (F3: GitHub cron is not that clock). The digest's own latch/cadence gate keep it hourly.
OnCalendar=*:0/5
# Spreads the send off the top of the hour, where ict-hourly-snapshot already
# fires, so the two do not hit the Telegram bridge in the same second.
RandomizedDelaySec=45
# Persistent=true replays a tick missed while the box was down. The runner's
# own HOUR-granular latch is what stops a replay double-sending: a replayed
# firing inside an hour that already sent is a no-op, and one in a NEW hour is
# a digest the operator genuinely has not seen.
Persistent=true
Unit=ict-work-digest.service

[Install]
WantedBy=timers.target
