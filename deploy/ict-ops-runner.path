# ============================================
# ICT OPS RUNNER — path trigger (MANAGER-VM-DIRECT-OPS)
# Starts ict-ops-runner.service whenever the direct ops channel's queue dir is
# not empty. The web API (POST /api/bot/ops/actions) writes the job files; the
# runner runs them out of process. The literal path must equal
# src/runtime/ops_actions.py::VM_OPS_DIR / "queue" (tests/test_ops_actions.py).
# Installed + enabled by scripts/install_systemd_units.sh (trader box only).
# ============================================

[Unit]
Description=ICT ops channel queue watch
# OPS-RUNNER-START-LIMIT: never rate-limit the watch itself either (see ict-ops-runner.service).
StartLimitIntervalSec=0

[Path]
DirectoryNotEmpty=/data/bot-data/runtime_logs/ops/queue
Unit=ict-ops-runner.service

[Install]
WantedBy=multi-user.target
