# ============================================
# Every-3-hours cadence for the drift-retrain scan (S-MLOPT-S16).
# Was hourly until 2026-10-16: operator popup ~06:32Z, verbatim "Every 3h (Recommended)"
# (row TRAINER-DRIFT-NEXT Q1). MEASURED before the change (trainer-vm-diag #18485): each plan-only
# scan costs 12.0-12.7 CPU-min and holds the heavy-job lock ~12 min of every hour, ~293
# trainer-CPU-min/day; every 3 h is ~98/day. Revert: OnCalendar=*-*-* 00/3:05:00 + daemon-reload.
# ADWIN scans the head's full real-time score series each pass (no
# incremental on-disk state), so cadence is purely "how often do we
# want to react to a fresh drift?" — not memory pressure. Composes
# with the daily ict-trainer.timer cron.
#
# Save to (trainer VM): /etc/systemd/system/ict-drift-retrain.timer
# Install: see ict-drift-retrain.service header.
# ============================================

[Unit]
Description=Periodic ICT drift-retrain scan

[Timer]
OnCalendar=*-*-* 00/3:05:00
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
