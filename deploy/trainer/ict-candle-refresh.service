# ============================================
# Trainer candle refresh (PI-20260929-FCJRWVAK-0002): the OWNER of
# data/<SYM>_15m.csv freshness. Extends the multi-year files forward from their
# last bar (append + dedupe on timestamp); never truncates or rewrites history.
# scripts/ops/refresh_candle_history.py refuses a shrinking write.
#
# **TRAINER VM ONLY** — lives in deploy/trainer/ so the live-VM unit installer
# (globs deploy/*.service) never picks it up. Non-money path (research data).
# Install (reproducible): sudo bash scripts/ops/install_trainer_candle_refresh.sh
# ============================================

[Unit]
Description=ICT trainer candle refresh (extend-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ict-trading-bot
# Worst case: 15 feeds x (20 rate-limit retries x 30s = 10 min) = 150 min, plus paging; a normal day extends ~1 day per feed.
# 9000s covers that; a timeout loses nothing anyway (atomic write, original untouched).
TimeoutStartSec=9000
# Daily ETF/futures 1d files extended from the maintained lake (basis-checked, ratio-spliced with a .splice.json
# sidecar; extends, never creates) and the Bybit funding files extended forward (PI-20261118-MANAYJZO-0002).
# They run FIRST with the '-' prefix: each is independent of the crypto refresh and can never fail the unit.
ExecStart=-/home/ubuntu/ict-trading-bot/.venv/bin/python -u scripts/ops/extend_data_from_lake.py --data-dir data --lake datasets-out/market_raw --apply
ExecStart=-/home/ubuntu/ict-trading-bot/.venv/bin/python -u scripts/ops/refresh_funding_history.py --data-dir data ADAUSDT AVAXUSDT BTCUSDT ETHUSDT SOLUSDT XRPUSDT
ExecStart=/home/ubuntu/ict-trading-bot/.venv/bin/python -u scripts/ops/refresh_candle_history.py --data-dir data SOLUSDT:15 XRPUSDT:15 ETHUSDT:15 ADAUSDT:15 AVAXUSDT:15 BNBUSDT:15 LINKUSDT:15 BTCUSDT:15 ADAUSDT:5 AVAXUSDT:5 BNBUSDT:5 LINKUSDT:5 ETHUSDT:5 SOLUSDT:5 XRPUSDT:5
# Report-only freshness of every data/*.csv (PI-20261118-MANAYJZO-0002); the '-' prefix means it can never fail the unit.
# TRAINER-1D-STALE-ROSTERED (manager 2026-11-19 08:21Z, decision a): the crypto 1h/2h/4h files the m20 sweep
# reads for REAL-MONEY legs (eth_4h, xrp_4h, ada_2h, sol_prop 1h) froze at ~2026-06-18 because only 15m/5m
# were refreshed. Same Bybit refresher, same venue as the history. Its own '-' line: a pair whose file does
# not exist exits 1 (extends, never creates) and must not fail the 15m/5m refresh above it.
ExecStart=-/home/ubuntu/ict-trading-bot/.venv/bin/python -u scripts/ops/refresh_candle_history.py --data-dir data ADAUSDT:60 ADAUSDT:120 ADAUSDT:240 AVAXUSDT:60 AVAXUSDT:120 AVAXUSDT:240 BTCUSDT:60 BTCUSDT:120 BTCUSDT:240 ETHUSDT:60 ETHUSDT:120 ETHUSDT:240 SOLUSDT:60 SOLUSDT:120 SOLUSDT:240 XRPUSDT:60 XRPUSDT:120 XRPUSDT:240
ExecStartPost=-/home/ubuntu/ict-trading-bot/.venv/bin/python -u scripts/ops/report_data_freshness.py --data-dir data --alert-rostered
# TRAINER-1D-STALE-ROSTERED: forward the stale-rostered-data ping to the live VM queue (the trainer has no
# drainer); same key and path as ict-notify-failure@.service.
Environment=UNIT_FAILURE_FORWARD=live
Environment=UNIT_FAILURE_HOST_LABEL=trainer
StandardOutput=journal
StandardError=journal
